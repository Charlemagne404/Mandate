{
  "name": "@mandate/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --external:fastify --external:zod --external:@fastify/static --outfile=dist/main.js --sourcemap",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "zod": "4.6.5",
    "@fastify/static": "8.3.0",
    "@mandate/core": "workspace:*",
    "@mandate/persistence": "workspace:*",
    "@mandate/scenarios": "workspace:*",
    "@mandate/schemas": "workspace:*",
    "fastify": "5.12.5",
    "@mandate/ai": "workspace:*",
    "@mandate/memory": "workspace:*"
  }
}
