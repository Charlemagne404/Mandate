{
  "name": "mandate",
  "private": true,
  "version": "0.3.0-alpha.1",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"pnpm --filter @mandate/server dev\" \"pnpm --filter @mandate/web dev\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:soak": "vitest run tests/soak",
    "test:e2e": "playwright test",
    "build": "pnpm -r --if-present build",
    "start": "pnpm --filter @mandate/server start",
    "geography:ingest": "tsx tools/ingest-geography.ts",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "desktop:build": "pnpm build",
    "desktop:start": "pnpm --filter @mandate/desktop start",
    "desktop:package": "pnpm build && pnpm --filter @mandate/desktop package",
    "test:desktop": "tsx tools/desktop-smoke.ts",
    "world:ingest": "tsx tools/ingest-global-world.ts",
    "world:regional:ingest": "tsx tools/ingest-regional-world.ts",
    "scenario:validate": "tsx tools/validate-scenarios.ts",
    "test:ai": "vitest run tests/ai",
    "ai:eval": "tsx tools/ai-eval.ts",
    "ai:eval:real": "tsx tools/ai-eval.ts --real",
    "autoplay": "tsx tools/autoplay.ts",
    "soak:world": "tsx tools/autoplay.ts",
    "ai:discover": "tsx tools/discover-models.ts",
    "ai:benchmark": "tsx tools/behavior-eval.ts",
    "ai:benchmark:real": "tsx tools/behavior-eval.ts --real",
    "ai:playtests:real": "tsx tools/real-playtests.ts",
    "ai:playtest:war:real": "tsx tools/war-control-playtest.ts",
    "ai:playtest:caeu": "tsx tools/caeu-campaign-playtest.ts",
    "ai:playtest:puppetmaster": "tsx tools/puppetmaster-campaign-playtest.ts",
    "ai:playtest:puppetmaster:real": "tsx tools/puppetmaster-rival-campaign-real-playtest.ts",
    "ai:playtest:caeu:real": "tsx tools/caeu-campaign-real-playtest.ts",
    "ai:playtest:agency:real": "tsx tools/player-agency-playtest.ts",
    "ai:playtest:intent:real": "tsx tools/player-intent-regression-real.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mandate/ai": "workspace:*",
    "@mandate/core": "workspace:*",
    "@mandate/memory": "workspace:*",
    "@mandate/persistence": "workspace:*",
    "@mandate/scenarios": "workspace:*",
    "@mandate/schemas": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.27.0",
    "eslint": "10.11.0",
    "globals": "^16.5.0",
    "playwright": "1.63.0",
    "prettier": "^3.7.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  }
}
