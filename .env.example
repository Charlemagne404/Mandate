# Paths are server-owner configuration, never accepted from HTTP requests.
MANDATE_DB=.runtime/world.sqlite
MANDATE_SCENARIO=global-alpha.json
PORT=3001
MANDATE_WEB_PORT=5173
# Optional CLI evaluation provider; the game stores its own local settings.
# MANDATE_AI_KIND=ollama
# MANDATE_AI_MODEL=<your-installed-model>
# MANDATE_AI_URL=http://127.0.0.1:11434
# Optional benchmark role routing and timeout (milliseconds).
# MANDATE_AI_ROLE_MODELS={"planner":"your-model","diplomat":"your-model"}
# MANDATE_AI_TIMEOUT=60000

# Optional explicit Ollama token context; independent from application character budgets.
# MANDATE_AI_CONTEXT_TOKENS=8192
